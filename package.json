{
  "name": "multi-column-markdown",
  "displayName": "Advanced Multi Column",
  "description": "Render interactive, nested multi-column layouts in Markdown preview — marker-based syntax (%% col-start %%), style tokens, stack groups, wikilinks and embeds.",
  "version": "0.5.0",
  "publisher": "local",
  "license": "AGPL-3.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "columns",
    "multi-column",
    "layout",
    "preview"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "multiColumnMarkdown.insert2",
        "title": "Insert 2-wide layout",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insert3",
        "title": "Insert 3-wide layout",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insert4",
        "title": "Insert 4-wide layout",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insertLayout",
        "title": "Insert layout (custom count)",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insertNested",
        "title": "Insert nested layout (parent + children)",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insertSidebar",
        "title": "Insert sidebar + content layout",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insertResponsiveSidebar",
        "title": "Insert responsive sidebar layout",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insertStacked",
        "title": "Insert stacked + wide layout",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insertCornell",
        "title": "Insert Cornell notes layout",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insertKanban",
        "title": "Insert Kanban board layout",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.insertInfoCard",
        "title": "Insert info card layout",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.openPreview",
        "title": "Open Markdown Preview (Columns)",
        "category": "Advanced Multi Column"
      },
      {
        "command": "multiColumnMarkdown.dataviewStats",
        "title": "Show Dataview Stats (index / cache / workers)",
        "category": "Advanced Multi Column"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "multiColumnMarkdown.insertMenu",
          "group": "1_insert@1",
          "when": "editorLangId == markdown"
        }
      ],
      "multiColumnMarkdown.insertMenu": [
        {
          "command": "multiColumnMarkdown.insert2",
          "group": "insert@1"
        },
        {
          "command": "multiColumnMarkdown.insert3",
          "group": "insert@2"
        },
        {
          "command": "multiColumnMarkdown.insert4",
          "group": "insert@3"
        },
        {
          "command": "multiColumnMarkdown.insertLayout",
          "group": "insert@4"
        },
        {
          "command": "multiColumnMarkdown.insertNested",
          "group": "templates@1"
        },
        {
          "command": "multiColumnMarkdown.insertSidebar",
          "group": "templates@2"
        },
        {
          "command": "multiColumnMarkdown.insertStacked",
          "group": "templates@3"
        },
        {
          "command": "multiColumnMarkdown.insertCornell",
          "group": "templates@4"
        },
        {
          "command": "multiColumnMarkdown.insertKanban",
          "group": "templates@5"
        },
        {
          "command": "multiColumnMarkdown.insertInfoCard",
          "group": "templates@6"
        }
      ]
    },
    "submenus": [
      {
        "id": "multiColumnMarkdown.insertMenu",
        "label": "Insert Column Layout"
      }
    ],
    "configuration": {
      "title": "Advanced Multi Column",
      "properties": {
        "multiColumnMarkdown.defaultColumnCount": {
          "type": "number",
          "default": 2,
          "minimum": 2,
          "maximum": 6,
          "markdownDescription": "Default number of columns used by the **Insert layout (custom count)** command."
        },
        "multiColumnMarkdown.minColumnWidthPercent": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 30,
          "markdownDescription": "[Not implemented yet] Minimum column width (%) enforced when resizing columns by dragging the divider."
        },
        "multiColumnMarkdown.inheritStyleOnAdd": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "[Not implemented yet] When adding a column, inherit the style of the neighboring column."
        },
        "multiColumnMarkdown.enableSlashSuggest": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "[Not implemented yet] Show slash-command suggestions (`/`) inside column editors."
        },
        "multiColumnMarkdown.styleTargetMode": {
          "type": "string",
          "enum": [
            "all",
            "specific"
          ],
          "enumDescriptions": [
            "Apply container appearance to all columns",
            "Apply container appearance to a specific column index"
          ],
          "default": "all",
          "markdownDescription": "[Not implemented yet] Style target for the container appearance defaults below."
        },
        "multiColumnMarkdown.styleTargetColumnIndex": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 6,
          "markdownDescription": "[Not implemented yet] Column index (1-based) used when `styleTargetMode` is `specific`."
        },
        "multiColumnMarkdown.containerBackground": {
          "type": "string",
          "enum": [
            "transparent",
            "primary",
            "secondary",
            "alt",
            "accent-soft",
            "red-soft",
            "orange-soft",
            "yellow-soft",
            "green-soft",
            "cyan-soft",
            "blue-soft",
            "pink-soft"
          ],
          "enumDescriptions": [
            "Transparent",
            "Primary background",
            "Secondary background",
            "Muted background",
            "Accent tint",
            "Red tint",
            "Orange tint",
            "Yellow tint",
            "Green tint",
            "Cyan tint",
            "Blue tint",
            "Pink tint"
          ],
          "default": "primary",
          "markdownDescription": "[Not implemented yet] Default container background."
        },
        "multiColumnMarkdown.showContainerBorder": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "[Not implemented yet] Show the container border."
        },
        "multiColumnMarkdown.containerBorderWidthPx": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 8,
          "markdownDescription": "[Not implemented yet] Container border width (px)."
        },
        "multiColumnMarkdown.containerBorderColor": {
          "type": "string",
          "enum": [
            "gray",
            "accent",
            "muted",
            "text",
            "red",
            "orange",
            "yellow",
            "green",
            "cyan",
            "blue",
            "pink"
          ],
          "default": "gray",
          "markdownDescription": "[Not implemented yet] Container border color."
        },
        "multiColumnMarkdown.containerCornerRadiusPx": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 24,
          "markdownDescription": "[Not implemented yet] Container corner radius (px)."
        },
        "multiColumnMarkdown.containerTextColor": {
          "type": "string",
          "enum": [
            "gray",
            "accent",
            "muted",
            "text",
            "red",
            "orange",
            "yellow",
            "green",
            "cyan",
            "blue",
            "pink"
          ],
          "default": "text",
          "markdownDescription": "[Not implemented yet] Container text color."
        },
        "multiColumnMarkdown.verticalDividerWidthPx": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 8,
          "markdownDescription": "[Not implemented yet] Width of the divider between columns (px)."
        },
        "multiColumnMarkdown.verticalDividerStyle": {
          "type": "string",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "double"
          ],
          "default": "solid",
          "markdownDescription": "[Not implemented yet] Line style of the divider between columns."
        },
        "multiColumnMarkdown.verticalDividerColor": {
          "type": "string",
          "enum": [
            "gray",
            "accent",
            "muted",
            "text",
            "red",
            "orange",
            "yellow",
            "green",
            "cyan",
            "blue",
            "pink"
          ],
          "default": "gray",
          "markdownDescription": "[Not implemented yet] Color of the divider between columns."
        },
        "multiColumnMarkdown.enableHeaders": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "[Not implemented yet] Render column headers from `!type: Title` first lines. Configure header types with the **Advanced Multi Column: Configure Column Headers** command."
        },
        "multiColumnMarkdown.dataview.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Render ```dataview and ```dataviewjs code blocks in the Markdown preview. Applies on the next preview render."
        },
        "multiColumnMarkdown.dataview.timeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 120000,
          "markdownDescription": "Per-block execution budget (ms). A block that exceeds it has its worker thread terminated and is reported as an error; other blocks are unaffected."
        },
        "multiColumnMarkdown.dataview.maxRows": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "maximum": 50000,
          "markdownDescription": "Maximum rows rendered per dataview table/query. Larger result sets are truncated with a notice; the webview virtualizes whatever is rendered."
        },
        "multiColumnMarkdown.dataview.workerPoolSize": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "markdownDescription": "Worker threads executing dataview code. Blocks from the same file are pinned to one worker; more workers only help when many files are previewed at once."
        },
        "multiColumnMarkdown.dataview.cacheSize": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "maximum": 10000,
          "markdownDescription": "Rendered block cache entries (LRU). Cache keys include the index version, so edits invalidate results automatically."
        },
        "multiColumnMarkdown.dataview.renderNullAs": {
          "type": "string",
          "default": "-",
          "markdownDescription": "Text used for null/undefined values in tables and lists (Dataview's `renderNullAs`)."
        },
        "multiColumnMarkdown.dataview.dateFormat": {
          "type": "string",
          "default": "yyyy-MM-dd",
          "markdownDescription": "Date rendering format (Dataview's `defaultDateFormat`; tokens yyyy/MM/dd/HH/mm/ss)."
        },
        "multiColumnMarkdown.dataview.maxRenderDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 16,
          "markdownDescription": "How deep nested arrays/objects are rendered inside a cell before showing `…` (Dataview's `maxRecursiveRenderDepth`)."
        },
        "multiColumnMarkdown.dataview.showResultCount": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Append a small \"N results\" badge under each block (Dataview's `displayResultCount`)."
        },
        "multiColumnMarkdown.dataview.inlineQueries": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable inline queries: `` `= expr ` `` (DQL) and `` `$= expr ` `` (JS) inside note text."
        },
        "multiColumnMarkdown.dataview.inlinePrefix": {
          "type": "string",
          "default": "=",
          "markdownDescription": "Prefix that marks an inline DQL expression (Dataview's \"Inline Query Prefix\")."
        },
        "multiColumnMarkdown.dataview.jsInlinePrefix": {
          "type": "string",
          "default": "$=",
          "markdownDescription": "Prefix that marks an inline JavaScript expression (Dataview's \"Javascript Inline Query Prefix\")."
        },
        "multiColumnMarkdown.dataview.indexExclude": {
          "type": "string",
          "default": "**/{node_modules,.git,dist,out,.obsidian,.trash}/**",
          "markdownDescription": "Glob of files excluded from the dataview index (passed to the file search). Requires reloading the window to rebuild the index."
        },
        "multiColumnMarkdown.headerTypes": {
          "type": "array",
          "default": [
            {
              "id": "note",
              "icon": "pencil",
              "background": "blue-soft",
              "textColor": "blue",
              "fontSize": 0.85,
              "fontWeight": 600
            },
            {
              "id": "info",
              "icon": "info",
              "background": "cyan-soft",
              "textColor": "cyan",
              "fontSize": 0.85,
              "fontWeight": 600
            },
            {
              "id": "tip",
              "icon": "lightbulb",
              "background": "green-soft",
              "textColor": "green",
              "fontSize": 0.85,
              "fontWeight": 600
            },
            {
              "id": "warning",
              "icon": "triangle-alert",
              "background": "orange-soft",
              "textColor": "orange",
              "fontSize": 0.85,
              "fontWeight": 600
            },
            {
              "id": "danger",
              "icon": "zap",
              "background": "red-soft",
              "textColor": "red",
              "fontSize": 0.85,
              "fontWeight": 600
            }
          ],
          "markdownDescription": "[Not implemented yet] Column header type presets. Edit via **Advanced Multi Column: Configure Column Headers** or directly as JSON."
        }
      }
    },
    "markdown.previewStyles": [
      "./media/previewStyle.css",
      "./media/dataview.css"
    ],
    "markdown.previewScripts": [
      "./dist/dataviewWebview.js"
    ],
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "build": "tsc -noEmit -p tsconfig.json && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "NODE_PATH=./test/helpers/node_modules node --test test/*.test.mjs",
    "benchmark": "NODE_PATH=./test/helpers/node_modules node --test --test-reporter=spec test/benchmark.test.mjs",
    "package": "npm run build && vsce package",
    "lint": "tsc -noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "markdown-it": "^14.1.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@12.3.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/illegal-xd/multi-column-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/illegal-xd/multi-column-markdown/issues"
  },
  "homepage": "https://github.com/illegal-xd/multi-column-markdown"
}
